{
  "name": "claude-multirepo-sessions",
  "displayName": "Multi-Repo Sessions for Claude Code",
  "version": "0.2.0",
  "description": "All your Claude Code sessions across projects in one list. One click opens a session's worktree in VS Code and resumes it.",
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "agent",
    "claude",
    "claude code",
    "git",
    "resume",
    "sessions",
    "worktree"
  ],
  "homepage": "https://github.com/fallemand/claude-multirepo-sessions#readme",
  "bugs": {
    "url": "https://github.com/fallemand/claude-multirepo-sessions/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fallemand/claude-multirepo-sessions"
  },
  "publisher": "fallemand",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "vp pack",
    "watch": "vp pack --watch",
    "check": "vp check",
    "vscode:prepublish": "pnpm build",
    "package": "vsce package --no-dependencies",
    "test": "vp test && pnpm test:integration",
    "test:integration": "vp pack && rm -rf out && tsc -p . && vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.95.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "ovsx": "^1.4.0",
    "typescript": "^7.0.2",
    "vite-plus": "1.7.0"
  },
  "contributes": {
    "configuration": {
      "title": "Multi-Repo Sessions",
      "properties": {
        "multirepoSessions.openIn": {
          "type": "string",
          "enum": [
            "editor",
            "terminal"
          ],
          "enumDescriptions": [
            "Resume in a Claude Code tab (requires the Claude Code extension).",
            "Resume with `claude --resume` in an integrated terminal."
          ],
          "default": "terminal",
          "description": "Where clicking a session resumes it."
        },
        "multirepoSessions.maxProjects": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "Projects listed before the rest fold into a \"N more projects\" row. The current project and projects with live sessions are always listed."
        },
        "multirepoSessions.maxPastSessions": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "Past sessions listed per project before an \"N older\" row; each click on it shows this many more."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "multirepoSessions.list",
          "name": "Multi-Repo Sessions",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "multirepoSessions.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "multirepoSessions.showLiveOnly",
        "title": "Show Live Sessions Only",
        "icon": "$(filter)"
      },
      {
        "command": "multirepoSessions.showAll",
        "title": "Show All Sessions",
        "icon": "$(filter-filled)"
      },
      {
        "command": "multirepoSessions.groupByStatus",
        "title": "Group by Status",
        "icon": "$(pulse)"
      },
      {
        "command": "multirepoSessions.groupByRepo",
        "title": "Group by Repository",
        "icon": "$(repo)"
      },
      {
        "command": "multirepoSessions.pickLayout",
        "title": "Row Layout…"
      },
      {
        "command": "multirepoSessions.toggleMore",
        "title": "Show More"
      },
      {
        "command": "multirepoSessions.sendFeedback",
        "title": "Send Feedback…",
        "icon": "$(feedback)"
      },
      {
        "command": "multirepoSessions.open",
        "title": "Open Session",
        "icon": "$(go-to-file)"
      },
      {
        "command": "multirepoSessions.openInNewWindow",
        "title": "Open in New Window",
        "icon": "$(empty-window)"
      },
      {
        "command": "multirepoSessions.resumeInEditor",
        "title": "Resume in Claude Tab"
      },
      {
        "command": "multirepoSessions.resumeInTerminal",
        "title": "Resume in Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "multirepoSessions.copyId",
        "title": "Copy Session ID"
      },
      {
        "command": "multirepoSessions.revealTranscript",
        "title": "Reveal Transcript"
      },
      {
        "command": "multirepoSessions.openPr",
        "title": "Open Pull Request",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "multirepoSessions.createWorktree",
        "title": "Create Worktree for Branch",
        "icon": "$(git-branch)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "multirepoSessions.showLiveOnly",
          "when": "view == multirepoSessions.list && multirepoSessions.filter == all",
          "group": "navigation@1"
        },
        {
          "command": "multirepoSessions.showAll",
          "when": "view == multirepoSessions.list && multirepoSessions.filter == live",
          "group": "navigation@1"
        },
        {
          "command": "multirepoSessions.groupByStatus",
          "when": "view == multirepoSessions.list && multirepoSessions.groupBy == repo",
          "group": "1_layout@1"
        },
        {
          "command": "multirepoSessions.groupByRepo",
          "when": "view == multirepoSessions.list && multirepoSessions.groupBy == status",
          "group": "1_layout@1"
        },
        {
          "command": "multirepoSessions.refresh",
          "when": "view == multirepoSessions.list",
          "group": "0_refresh"
        },
        {
          "command": "multirepoSessions.pickLayout",
          "when": "view == multirepoSessions.list",
          "group": "1_layout@2"
        },
        {
          "command": "multirepoSessions.sendFeedback",
          "when": "view == multirepoSessions.list",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "multirepoSessions.openInNewWindow",
          "when": "view == multirepoSessions.list && viewItem =~ /^session/",
          "group": "inline"
        },
        {
          "command": "multirepoSessions.open",
          "when": "view == multirepoSessions.list && viewItem =~ /^session/",
          "group": "1_open@1"
        },
        {
          "command": "multirepoSessions.openInNewWindow",
          "when": "view == multirepoSessions.list && viewItem =~ /^session/",
          "group": "1_open@2"
        },
        {
          "command": "multirepoSessions.resumeInTerminal",
          "when": "view == multirepoSessions.list && viewItem =~ /^session/ && config.multirepoSessions.openIn != terminal",
          "group": "1_open@3"
        },
        {
          "command": "multirepoSessions.resumeInEditor",
          "when": "view == multirepoSessions.list && viewItem =~ /^session/ && config.multirepoSessions.openIn == terminal",
          "group": "1_open@3"
        },
        {
          "command": "multirepoSessions.openPr",
          "when": "view == multirepoSessions.list && viewItem =~ /hasPr/",
          "group": "2_git@1"
        },
        {
          "command": "multirepoSessions.createWorktree",
          "when": "view == multirepoSessions.list && viewItem =~ /needsWorktree/",
          "group": "2_git@2"
        },
        {
          "command": "multirepoSessions.copyId",
          "when": "view == multirepoSessions.list && viewItem =~ /^session/",
          "group": "3_info@1"
        },
        {
          "command": "multirepoSessions.revealTranscript",
          "when": "view == multirepoSessions.list && viewItem =~ /^session/",
          "group": "3_info@2"
        }
      ],
      "commandPalette": [
        {
          "command": "multirepoSessions.toggleMore",
          "when": "false"
        },
        {
          "command": "multirepoSessions.open",
          "when": "false"
        },
        {
          "command": "multirepoSessions.openInNewWindow",
          "when": "false"
        },
        {
          "command": "multirepoSessions.resumeInTerminal",
          "when": "false"
        },
        {
          "command": "multirepoSessions.resumeInEditor",
          "when": "false"
        },
        {
          "command": "multirepoSessions.copyId",
          "when": "false"
        },
        {
          "command": "multirepoSessions.revealTranscript",
          "when": "false"
        },
        {
          "command": "multirepoSessions.openPr",
          "when": "false"
        },
        {
          "command": "multirepoSessions.createWorktree",
          "when": "false"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "multirepoSessions.list",
        "contents": "No live Claude sessions.\n[Show All Sessions](command:multirepoSessions.showAll)",
        "when": "multirepoSessions.filter == live"
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "media/logo.png",
  "galleryBanner": {
    "color": "#C15F3C",
    "theme": "dark"
  },
  "preview": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "packageManager": "pnpm@12.21.0"
}
