{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "watch",
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^\\s*\\[(ERROR)\\] (.*)$", "severity": 1, "message": 2 },
        "background": {
          "activatesOnStart": true,
          "beginsPattern": "Build start|rebuilding",
          "endsPattern": "Rebuilt in|Build complete|Build failed|\\[ERROR\\]"
        }
      },
      "presentation": { "reveal": "never" },
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
